{
  "name": "visapulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-site.mjs",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check:site": "node scripts/check-site.mjs",
    "check": "npm test && npm run typecheck && npm run data:validate && npm run build && npm run check:site",
    "data:fetch": "node scripts/fetch-archive.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:crosscheck": "node scripts/crosscheck.mjs",
    "data:add": "node scripts/add-bulletin.mjs",
    "data:backfill": "node scripts/fetch-archive.mjs --all && (node scripts/build-data.mjs; node scripts/validate-data.mjs && node scripts/crosscheck.mjs)"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "description": "The U.S. Visa Bulletin, verified against the official source and readable.",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
