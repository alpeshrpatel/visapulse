{
  "name": "visapulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "data:fetch": "node scripts/fetch-archive.mjs",
    "data:build": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:crosscheck": "node scripts/crosscheck.mjs",
    "data:add": "node scripts/add-bulletin.mjs",
    "data:backfill": "node scripts/fetch-archive.mjs --all && (node scripts/build-data.mjs; node scripts/validate-data.mjs && node scripts/crosscheck.mjs)"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  },
  "description": "The U.S. Visa Bulletin, verified against the official source and readable.",
  "engines": {
    "node": ">=22"
  }
}
